{
  "name": "stack-template",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/bouwen.mjs",
    "preview": "vite preview --port 4173 --host 127.0.0.1 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:e2e": "playwright test",
    "beheer:test": "node --test \"beheer/**/*.test.mjs\"",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm guard",
    "guard": "pnpm guard:tests && pnpm guard:migrations && pnpm guard:rls && pnpm guard:secrets && pnpm guard:escapes && pnpm guard:template && pnpm guard:cloudflare",
    "guard:tests": "node scripts/guard-tests.mjs",
    "guard:migrations": "node scripts/guard-migrations.mjs",
    "guard:rls": "node scripts/guard-rls.mjs",
    "guard:secrets": "node scripts/guard-secrets.mjs",
    "guard:escapes": "node scripts/guard-escape-hatches.mjs",
    "guard:template": "node scripts/guard-template.mjs",
    "guard:cloudflare": "node scripts/guard-cloudflare.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/write-db-types.mjs",
    "db:types:check": "node scripts/check-types-in-sync.mjs",
    "db:types:uit-ci": "node scripts/types-uit-ci.mjs",
    "env:local": "node scripts/write-local-env.mjs",
    "env:test": "node scripts/write-test-env.mjs",
    "testlogin": "node scripts/testlogin.mjs",
    "apparaat:nieuw": "node scripts/apparaat-nieuw.mjs"
  },
  "dependencies": {
    "@sentry/react": "^11.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  }
}
